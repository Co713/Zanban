# 复制为 .env 后填写真实配置

# 服务
PUBLIC_BASE_URL=http://127.0.0.1:8000
JWT_SECRET=请改成足够长的随机字符串
CORS_ORIGINS=*

# 阿里云短信（真实发码）
# 控制台：https://dysms.console.aliyun.com/
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
# 模板变量名，常见为 code
ALIYUN_SMS_TEMPLATE_PARAM_KEY=code

# 微信开放平台「网站应用」扫码登录
# 控制台：https://open.weixin.qq.com/
# 需配置授权回调域，并使用公网 HTTPS（可用内网穿透）
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# 高德地图 Web 端（JS API）Key — 用于真实地图与定位
# 控制台：https://console.amap.com/dev/key/app
# Key 类型选「Web端(JS API)」；并配置安全密钥 / 域名白名单（本地可加 127.0.0.1）
AMAP_KEY=
AMAP_SECURITY_JS_CODE=
